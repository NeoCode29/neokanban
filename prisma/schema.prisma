datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  boards       Board[]               @relation("BoardOwner")
  memberBoards BoardMember[]
  assignedCards CardAssignee[]
  tokens       PersonalAccessToken[]
  comments     Comment[]
  createdSkills Skill[]              @relation("CreatedSkills")
  uiAnnotations UiAnnotation[]
}

model PersonalAccessToken {
  id         String    @id @default(cuid())
  name       String    // e.g. "Claude Desktop", "Cursor AI"
  tokenHash  String    @unique
  tokenHint  String    // e.g. "neokan_pat_...abcd"
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Board {
  id               String            @id @default(cuid())
  title            String
  description      String?
  isFavorite       Boolean           @default(false)
  ownerId          String
  owner            User              @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          BoardMember[]
  columns          Column[]
  projectContext   ProjectContext?
  contextDocuments ContextDocument[]
  installedSkills  BoardSkill[]
  uiPages          UiPage[]
  uiComponents     UiComponent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("COLLABORATOR")
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

model ContextDocument {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String   // e.g. "Coding Standards", "API Specs"
  fileName  String   // e.g. "guidelines.md", "endpoints.json"
  content   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, fileName])
  @@index([boardId])
}

model ProjectContext {
  id                  String   @id @default(cuid())
  boardId             String   @unique
  board               Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  guidelinesMarkdown  String   @default("")
  techStackMarkdown   String   @default("")
  conventionsMarkdown String   @default("")
  messagingStandards  String   @default("")
  updatedAt           DateTime @updatedAt
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String   // "Backlog", "To Do", "In Progress", "In Review", "Done"
  order     Int      @default(0)
  colorCode String?  @default("#64748b")
  cards     Card[]
  createdAt DateTime @default(now())
}

model Card {
  id          String          @id @default(cuid())
  columnId    String
  column      Column          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  order       Int             @default(0)
  priority    Priority        @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  tags        String[]        @default([])
  assignees   CardAssignee[]
  checklists  ChecklistItem[]
  comments    Comment[]
  uiAnnotations UiAnnotation[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CardAssignee {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cardId, userId])
  @@index([cardId])
  @@index([userId])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
}

model Comment {
  id            String   @id @default(cuid())
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName    String
  isAiGenerated Boolean  @default(false)
  content       String
  createdAt     DateTime @default(now())
}

model Skill {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String       @default("")
  category    String       @default("General") // e.g. "Testing", "Frontend", "Backend", "Security", "DevOps"
  targetRole  String       @default("FULLSTACK") // matches User specialization roles
  isPreset    Boolean      @default(false)
  authorId    String?
  author      User?        @relation("CreatedSkills", fields: [authorId], references: [id], onDelete: SetNull)
  files       SkillFile[]
  boardSkills BoardSkill[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@index([targetRole])
}

model SkillFile {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  filePath  String   // e.g. "SKILL.md", "examples/sample.ts", "scripts/verify.sh"
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, filePath])
  @@index([skillId])
}

model BoardSkill {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  installedAt DateTime @default(now())

  @@unique([boardId, skillId])
  @@index([boardId])
  @@index([skillId])
}

model UiPage {
  id          String         @id @default(cuid())
  boardId     String
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  path        String
  description String?        @db.Text
  status      String         @default("DRAFT")
  htmlContent String         @db.Text
  order       Int            @default(0)
  annotations UiAnnotation[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([boardId])
}

model UiComponent {
  id          String         @id @default(cuid())
  boardId     String
  board       Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  category    String         @default("General")
  description String?        @db.Text
  htmlContent String         @db.Text
  order       Int            @default(0)
  annotations UiAnnotation[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([boardId])
}

model UiAnnotation {
  id          String       @id @default(cuid())
  pageId      String?
  page        UiPage?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentId String?
  component   UiComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        String       @default("PIN")
  posX        Float
  posY        Float
  width       Float?
  height      Float?
  comment     String       @db.Text
  status      String       @default("OPEN")
  cardId      String?
  card        Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([pageId])
  @@index([componentId])
  @@index([authorId])
  @@index([cardId])
}


